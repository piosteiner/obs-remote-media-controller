# .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.production
# Production build settings are public URLs, not secrets
!frontend/.env.production
.env.development

# Build outputs
dist/
# browser tests: the test build and their output
frontend/dist-e2e/
frontend/test/e2e/.results/
build/
out/

# Backend specific
backend/uploads/*
!backend/uploads/.gitkeep
# Runtime data (library, slots, scenes) lives only on the server
backend/data/
backend/*.log
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Frontend specific
frontend/.vite/
frontend/dist/
frontend/.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
Desktop.ini

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.temp/
.tmp/

# Logs
logs/
*.log

# PM2
.pm2/

# SSL certificates (if stored locally)
*.pem
*.key
*.crt
